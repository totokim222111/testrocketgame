{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "testrocket:manifest",
  "title": "TESTROCKET manifest",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "defaultLanguage": {
      "type": "string",
      "minLength": 1
    },
    "active": {
      "type": "object",
      "properties": {
        "heroine": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "housing": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "mission": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        }
      },
      "required": [
        "heroine",
        "housing",
        "mission"
      ],
      "additionalProperties": false
    },
    "paths": {
      "type": "object",
      "properties": {
        "heroinesDir": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[a-zA-Z0-9_./-]+$"
        },
        "housingsDir": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[a-zA-Z0-9_./-]+$"
        },
        "missionsDir": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[a-zA-Z0-9_./-]+$"
        }
      },
      "required": [
        "heroinesDir",
        "housingsDir",
        "missionsDir"
      ],
      "additionalProperties": false
    },
    "allowQueryOverride": {
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "title",
    "subtitle",
    "defaultLanguage",
    "active",
    "paths",
    "allowQueryOverride"
  ],
  "additionalProperties": false
}
